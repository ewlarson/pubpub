{
  "name": "pubpub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ingest:faculty": "node scripts/ingest-faculty.mjs",
    "build:data": "node scripts/build-publications.mjs",
    "build:scholars": "node scripts/build-scholars.mjs",
    "build:grants": "node scripts/build-grants.mjs",
    "export:data": "node scripts/export-static-data.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "build:data:all": "npm run ingest:faculty && npm run build:data && npm run build:scholars && npm run build:grants && npm run export:data",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --test test/*.test.mjs",
    "build": "vite build",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-xml-parser": "^4.4.1",
    "globals": "^17.8.0",
    "vite": "^5.4.2"
  }
}
